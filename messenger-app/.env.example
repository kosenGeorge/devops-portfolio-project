# ===== Teleport PRO — конфигурация сервера =====
PORT=8080                      # порт HTTP+WebSocket
PUBLIC_URL=https://moy-domen.ru  # боевой адрес (для OAuth-редиректов)

# --- Почта (коды подтверждения регистрации, сброс пароля, опция кода по SMS-on-email) ---
SMTP_HOST=smtp.yandex.ru       # или smtp.gmail.com, smtp.mail.ru...
SMTP_PORT=465                  # 465 = TLS, 587 = STARTTLS
SMTP_USER=login@yandex.ru      # логин почты отправителя
SMTP_PASS=xxxxxxxxxxxx         # "пароль приложения" (Яндекс: Настройки -> Пароли приложений; Gmail: App Passwords)
SMTP_FROM=Teleport <login@yandex.ru>
EMAIL_MODE=1                   # 1 = код для входа по ТЕЛЕФОНу слать на e-mail аккаунта (без SMS-шлюза)

# --- SMS-шлюз для входа по номеру телефона (альтернатива EMAIL_MODE) ---
SMS_PROVIDER=smscru            # smscru | cellhippus
SMSCRU_LOGIN=ваш_логин
SMSCRU_PASSWORD=ваш_пароль
CELLHIPPUS_TOKEN=ваш_токен

# --- OAuth (включается позже) ---
VK_CLIENT_ID=
VK_CLIENT_SECRET=
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
