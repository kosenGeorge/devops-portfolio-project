version: '3.8'

services:
  website:
    build: .
    container_name: egor-website
    ports:
      - "8888:80"
    restart: unless-stopped

  # Второй сервис - например, простой whoami
  whoami:
    image: containous/whoami
    container_name: whoami-service
    ports:
      - "8889:80"
    restart: unless-stopped
